    <name>Origem_professores</name>
    <sql>SELECT p.mat_professor, u.nome,tipo_jornada_trabalho, formacao, departamento, d.nome AS lotacao
FROM universidade.professor p
JOIN universidade.usuario u ON u.cpf = p.cpf
JOIN universidade.departamento d ON d.cod_depto = p.departamento       </sql>
