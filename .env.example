# Configurações do PostgreSQL (01-relational-postgres e 03-data-warehouse-etl)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua_senha_segura

# Configurações do MongoDB (02-nosql-mongodb)
MONGODB_MODE=atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=universidade
DEMO_SEED=0

# Flask App (Aplicações web)
FLASK_SECRET_KEY=sua_chave_secreta_aleatoria_para_sessoes
